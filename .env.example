# Copy this file to .env for shared settings. For local development, put
# machine-specific overrides in .env.local. Production overrides belong in
# /srv/englisheval/shared/.env.prod and are not uploaded by deploy.sh.

# Server
PORT=3199
APP_BASE_URL=http://localhost:3199
COOKIE_SECURE=false

# DingTalk OAuth and H5 in-app passwordless login
DINGTALK_CORP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# Production monitoring uses shared/monitor.env; credentials remain in shared/.env.
DINGTALK_ALERTS_ENABLED=false
DINGTALK_ALERT_ROBOT_CODE=
DINGTALK_ALERT_USER_ID=
# Optional: send the 09:30 page-visit digest to a different robot or recipient
# than the resource alerts above. Both fall back to the DINGTALK_ALERT_ values.
DINGTALK_DIGEST_ROBOT_CODE=
DINGTALK_DIGEST_USER_ID=

# Use independent, randomly generated secrets for sessions and partner access.
# Example generator: openssl rand -hex 32
# Required for guest sessions when DINGTALK_APP_SECRET is absent; keep stable across restarts.
SESSION_SECRET=
PARTNER_API_KEY=

# Separate token entered by signed-in DingTalk users at /admin.
ADMIN_ACCESS_TOKEN=

# Access allow-lists (comma-separated openIds).
# Teacher console: once TEACHER_OPEN_IDS is non-empty, access is keyed on these
# stable openIds and DingTalk display names no longer grant it (names are
# user-changeable). Until then the built-in TEACHER_NAMES list applies and each
# teacher login logs "[teacher-enroll]" with the openId to enroll here.
TEACHER_OPEN_IDS=
# Optional: restrict invitation-code minting to designated members. Unset means
# every DingTalk-authenticated org member may create invitation codes.
INVITER_OPEN_IDS=

# Analytics beacons are throttled per client address; the events log is pruned
# to this many days by the web process (minimum 1; invalid values fall back
# to the default).
ANALYTICS_EVENTS_RETENTION_DAYS=180

# Internal OpenAI-compatible gateway
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_CHAT_COMPLETIONS_URL=https://api.example.com/v1/chat/completions
INTERNAL_LLM_TRANSCRIPTIONS_URL=https://api.example.com/v1/audio/transcriptions
TRANSCRIPTION_MAX_ATTEMPTS=3
INTERNAL_LLM_QUESTION_MODEL=glm
INTERNAL_LLM_EVAL_MODEL=qwen
INTERNAL_LLM_TRANSCRIBE_MODEL=qwen-asr

# OpenRouter fallback used when the internal gateway is unavailable.
# Applies to question generation, evaluation scoring, and comment moderation.
# Transcription has no fallback because OpenRouter exposes no audio endpoint.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_COMPLETIONS_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_EVAL_MODEL=z-ai/glm-5.3-flash
# Optional separate fallback models; each defaults to OPENROUTER_EVAL_MODEL.
OPENROUTER_QUESTION_MODEL=
OPENROUTER_MODERATION_MODEL=
# Transcription fallback (POST /api/v1/audio/transcriptions). Qwen3 ASR covers
# the same languages as the internal qwen-asr model; billed per audio second.
OPENROUTER_TRANSCRIBE_MODEL=qwen/qwen3-asr-1.7b

# Internal Qwen evaluation
EVAL_MAX_FRAMES=24
# Per-attempt scoring timeout. 3 attempts (1 initial + 2 retries) run before the
# OpenRouter fallback fires, so worst-case stall before fallback ≈ 3× this value.
# Normal scoring completes in 25–35s.
EVAL_REQUEST_TIMEOUT_MS=100000

# Durable queue and monitoring (Node >= 22.16). Run worker.js alongside server.js.
QUEUE_ENABLED=true
QUEUE_CAPACITY=50
QUEUE_WAITING_CAPACITY=200
FFMPEG_TIMEOUT_MS=180000
# Automatic CPU affinity/quota selection stays at 1-2. Explicit overrides allow 1-4.
# Production uses the versioned ops/englisheval-capacity.env profile.
FFMPEG_CONCURRENCY=
WORKER_CONCURRENCY=4

# Durable budgets shared by web/worker using queue.sqlite. These are this app's
# budgets; the shared gateway must separately enforce quotas for every API key.
MODEL_INTERNAL_CONCURRENT=3
MODEL_INTERNAL_RPM=30
MODEL_INTERNAL_TPM=120000
MODEL_QUESTION_CONCURRENT=2
MODEL_QUESTION_RPM=20
MODEL_QUESTION_TPM=120000
MODEL_TRANSCRIPTION_CONCURRENT=2
MODEL_TRANSCRIPTION_RPM=20
MODEL_SCORING_CONCURRENT=2
MODEL_SCORING_RPM=12
MODEL_SCORING_TPM=300000

# Production recording maintenance
# Set RECORDING_RETENTION_DAYS=0 to retain live recordings indefinitely.
RECORDING_RETENTION_DAYS=0
BACKUP_RETENTION_DAYS=30
# Public age recipient only (age1...). Keep the private identity offline.
BACKUP_AGE_RECIPIENT=
# false generates the maintenance unit without service stop/start: the nightly
# timer runs only retention and the orphan sweep, so the app is never restarted
# at night; deployment becomes the only restart. Takes effect on the next
# ./deploy.sh (it regenerates the unit). Default true.
RECORDING_BACKUP_ENABLED=true
# Optional off-site copy hook run after each nightly backup, e.g.
#   BACKUP_OFFLOAD_COMMAND='rsync -av'
# It receives the encrypted archive path and its .sha256 path. Unset means
# copying archives off-host is a manual step.
BACKUP_OFFLOAD_COMMAND=
