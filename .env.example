# Copy this file to .env for shared settings. For local development, put
# machine-specific overrides in .env.local. Production overrides belong in
# /opt/englisheval/shared/.env.prod and are not uploaded by deploy.sh.

# Server
PORT=3199
APP_BASE_URL=http://localhost:3199
COOKIE_SECURE=false

# DingTalk OAuth and H5 in-app passwordless login
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# Production monitoring uses shared/monitor.env; credentials remain in shared/.env.
DINGTALK_ALERTS_ENABLED=false
DINGTALK_ALERT_ROBOT_CODE=
DINGTALK_ALERT_USER_ID=

# Use independent, randomly generated secrets for sessions and partner access.
# Example generator: openssl rand -hex 32
# Required for guest sessions when DINGTALK_APP_SECRET is absent; keep stable across restarts.
SESSION_SECRET=
PARTNER_API_KEY=

# Separate token entered by signed-in DingTalk users at /admin.
ADMIN_ACCESS_TOKEN=

# Internal OpenAI-compatible gateway
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_CHAT_COMPLETIONS_URL=https://llm.zgci.org/hub/v1/chat/completions
INTERNAL_LLM_TRANSCRIPTIONS_URL=https://llm.zgci.org/hub/v1/audio/transcriptions
TRANSCRIPTION_MAX_ATTEMPTS=3
INTERNAL_LLM_QUESTION_MODEL=glm
INTERNAL_LLM_EVAL_MODEL=qwen
INTERNAL_LLM_TRANSCRIBE_MODEL=qwen-asr

# Internal Qwen evaluation
EVAL_MAX_FRAMES=24
EVAL_REQUEST_TIMEOUT_MS=600000

# Durable queue and monitoring (Node >= 22.16). Run worker.js alongside server.js.
QUEUE_ENABLED=true
QUEUE_CAPACITY=50
QUEUE_WAITING_CAPACITY=200
FFMPEG_TIMEOUT_MS=180000
# Automatic CPU affinity/quota selection stays at 1-2. Explicit overrides allow 1-4.
# Production uses the versioned ops/englisheval-capacity.env profile.
FFMPEG_CONCURRENCY=
WORKER_CONCURRENCY=4

# Durable budgets shared by web/worker using queue.sqlite. These are this app's
# budgets; the shared gateway must separately enforce quotas for every API key.
MODEL_INTERNAL_CONCURRENT=3
MODEL_INTERNAL_RPM=30
MODEL_INTERNAL_TPM=120000
MODEL_QUESTION_CONCURRENT=2
MODEL_QUESTION_RPM=20
MODEL_QUESTION_TPM=120000
MODEL_TRANSCRIPTION_CONCURRENT=2
MODEL_TRANSCRIPTION_RPM=20
MODEL_SCORING_CONCURRENT=2
MODEL_SCORING_RPM=12
MODEL_SCORING_TPM=300000

# Production recording maintenance
# Set RECORDING_RETENTION_DAYS=0 to retain live recordings indefinitely.
RECORDING_RETENTION_DAYS=0
BACKUP_RETENTION_DAYS=30
# Public age recipient only (age1...). Keep the private identity offline.
BACKUP_AGE_RECIPIENT=
