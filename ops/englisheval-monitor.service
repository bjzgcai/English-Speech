[Unit]
Description=EnglishEval resource monitoring and DingTalk alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/englisheval/current
EnvironmentFile=/opt/englisheval/shared/.env
EnvironmentFile=/opt/englisheval/shared/.env.prod
EnvironmentFile=-/opt/englisheval/shared/monitor.env
Environment=NODE_ENV=production
Environment=BACKUP_DIR=/opt/englisheval/backups
ExecStartPre=/usr/bin/mkdir -p /opt/englisheval/shared/recordings/monitor
ExecStart=/usr/bin/flock -n /opt/englisheval/shared/recordings/monitor/process.lock /usr/bin/node /opt/englisheval/current/monitor.js
Restart=always
RestartSec=5
TimeoutStopSec=90
MemoryMax=160M
CPUQuota=10%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/englisheval/shared/recordings /opt/englisheval/shared/questions /opt/englisheval/shared/comments /opt/englisheval/shared/consents /opt/englisheval/shared/ratings /opt/englisheval/shared/invitations
UMask=0077

[Install]
WantedBy=multi-user.target
