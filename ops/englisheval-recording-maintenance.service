[Unit]
Description=Encrypted OScanner-Eng recording backup and optional recording retention

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/opt/englisheval/shared/.env
EnvironmentFile=/opt/englisheval/shared/.env.prod
Environment=APP_ROOT=/opt/englisheval/current
Environment=RECORDINGS_DIR=/opt/englisheval/shared/recordings
Environment=BACKUP_DIR=/opt/englisheval/backups
ExecStartPre=/usr/bin/node /opt/englisheval/current/scripts/monitor-control.js maintenance 120
ExecStartPre=+/usr/bin/systemctl stop englisheval.service
ExecStartPre=+/usr/bin/systemctl stop englisheval-worker.service
ExecStart=/opt/englisheval/current/scripts/maintain-recordings.sh
ExecStopPost=+/usr/bin/systemctl start englisheval.service
ExecStopPost=+/usr/bin/systemctl start englisheval-worker.service
ExecStopPost=/usr/bin/node /opt/englisheval/current/scripts/monitor-control.js resume
TimeoutStartSec=110min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/englisheval/shared/recordings /opt/englisheval/backups
UMask=0077
