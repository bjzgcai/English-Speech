[Unit]
Description=OScanner-Eng evaluation worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/englisheval/current
EnvironmentFile=/opt/englisheval/shared/.env
EnvironmentFile=/opt/englisheval/shared/.env.prod
Environment=NODE_ENV=production
Environment=QUEUE_WORKER=true
Environment=QUEUE_START_PAUSED=true
ExecStart=/usr/bin/node /opt/englisheval/current/worker.js
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
MemoryHigh=900M
MemoryMax=1200M
CPUQuota=100%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/englisheval/shared/recordings /opt/englisheval/shared/questions /opt/englisheval/shared/comments /opt/englisheval/shared/consents /opt/englisheval/shared/ratings
UMask=0077

[Install]
WantedBy=multi-user.target
